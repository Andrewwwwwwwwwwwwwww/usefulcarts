{
	"schemaVersion": 1,
	"id": "usefulcarts",
	"version": "${version}",
	"name": "UsefulCarts",
	"description": "UsefulCarts adds horse-drawn and hand-pulled carts for travel, shipping and farming.",
	"authors": [
		"MennoMax",
		"paul101",
		"jmb19905"
	],
	"contact": {
		"sources": "https://github.com/jmb05/nifty-carts"
	},
	"license": "MIT",
	"icon": "assets/usefulcarts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.jmb19905.niftycarts.NiftyCarts"
		],
		"client": [
          "net.jmb19905.niftycarts.client.NiftyCartsClient"
		]
	},
	"mixins": [
		"usefulcarts.mixins.json",
		{
			"config": "usefulcarts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"forgeconfigapiport": ">=26.2.1"
	},
	"suggests": {
		"forgeconfigscreens": "*"
	},
	"accessWidener": "usefulcarts.accesswidener"
}